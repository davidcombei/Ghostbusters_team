+OPUS_APP_GUARD, OPUS_APP_DROP = ("opus:qq", "opus:wechat"), 6.0     # matched bona recall per app: down <= 6 points
+MATCHED_DROP, WF1_FALSIFIER, EP1_ACC_BAND, ATTRIBUTION_SHARE = 0.5, -0.5, 2.0, 0.5
