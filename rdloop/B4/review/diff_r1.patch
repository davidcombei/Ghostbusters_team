+def b4_class_row(by_class, meta_keys, levers):
+    """
+    (metrics.jsonl["b4"], the "B4 aug-by-class ..." log text) from train_epoch's meta_by_class:
+    {"levers": [...], "aug_by_class": {"bona": {"n": clips, "counts": {key: count}}, "spoof": {...}}}.
+    """
+    row = {"levers": list(levers), "aug_by_class": {}}
+    for name in ("bona", "spoof"):
+        vec = by_class.get(name)
+        counts = {k: int(v) for k, v in zip(meta_keys, vec.tolist()) if v} if vec is not None else {}
+        row["aug_by_class"][name] = {"n": int(by_class["n"][name]), "counts": counts}
+    text = " | ".join(f"{name}: n={d['n']}" + "".join(f" {k}={v}" for k, v in sorted(d["counts"].items()))
+                      for name, d in row["aug_by_class"].items())
+    return row, f"B4 aug-by-class {text}"
+
