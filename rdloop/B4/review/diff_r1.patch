+    edge = {"silence_zero_all_gated": bool(iz["gated_frac"] == 1.0 and not np.any(yz)),
+            "silence_cng_floor_white": bool(ic["white_fallback"] and abs(sil_cng_db - dsp_dtx.CNG_FLOOR_DBFS) <= 0.1),
