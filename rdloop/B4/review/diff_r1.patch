+def add_class_meta(acc, meta, labels):
+    """
+    B4 telemetry: add one batch's per-clip meta count vectors to `acc` separately for bonafide
+    (label 1) and spoof (label 0). acc = {"bona": vec | None, "spoof": vec | None, "n": {...}}.
+    Pure bookkeeping on CPU tensors: no RNG, no effect on the training step.
+    """
+    bona = labels.view(-1).to(meta.device) == 1
+    for name, sel in (("bona", bona), ("spoof", ~bona)):
+        part = meta[sel].sum(dim=0).to(torch.int64)
+        acc[name] = part if acc[name] is None else acc[name] + part
+        acc["n"][name] += int(sel.sum())
+    return acc
+
