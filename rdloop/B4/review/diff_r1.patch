+        aug = build_rtc_augmenter_b4(a)
+        ref2 = build_rtc_augmenter_b3(a)
+    clips = _synthetic_clips(n_clips, np.random.default_rng(31))
+    got = [aug(c.copy(), 16000) for c in clips]
