+def _ogg_packets(data):
+    """Opus packets of an Ogg stream (the OpusHead / OpusTags header packets dropped)."""
+    pkts, cur, pos = [], b"", 0
+    while pos + 27 <= len(data) and data[pos:pos + 4] == b"OggS":
+        nseg = data[pos + 26]
+        lac = data[pos + 27:pos + 27 + nseg]
+        body = pos + 27 + nseg
+        for L in lac:
+            cur += data[body:body + L]
+            body += L
+            if L < 255:
+                pkts.append(cur)
+                cur = b""
+        pos = body
