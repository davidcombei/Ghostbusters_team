+def dtx_gate_reading(res, panel):
+    """
+    dtx_gate decision lines (plan 2.2 falsifiers; code review F1.1 dose rule). (2) clean F1 down > 0.5 or a noisy /
+    VAD spoof-miss guard broken, on either readout -> Drop; (3) the shared under-fit falsifier -> Drop; (1) VAD DiD*
+    >= 0 (verdict readout) AND drop_high - drop_low <= the panel mean (full set, final) AND no outcome escape (WF1
