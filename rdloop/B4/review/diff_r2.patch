+def check_lever_failures(n=6, n_codec=12):
+    """
+    Code review F1.3: a worker-side lever failure is counted on every clip and printed once per process and op as
+    `[b4wave] <op> failed (<ExcType>: <exc>); <action>`, a line the wave's early check (`failed \\(`, the default
+    of scripts/exploop/supervisor.py) forbids, like the parent's `codec ... failed (...)`; a new pid prints again.
+    The backend calls are replaced by a raising stub (apm / dtx under the identity stubs; opus_plc with the real
+    init, so it needs libopus, and its ffmpeg fallback stubbed to a pass-through).
+    """
+    from b4wave import dsp_apm, dsp_dtx
+    from b4wave.augment import build_rtc_augmenter_b4
+    forbid = re.compile(r"failed \(")
+
+    def boom(*a, **k):
+        raise RuntimeError("stub backend failure")
+
+    def run(aug, k):
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            for c in _synthetic_clips(k, np.random.default_rng(41), seconds=0.5):
+                aug(c.copy(), 16000)
+        return buf.getvalue().splitlines()
+
+    def verdict(lid, op, key, action, aug, lines, lines2, expect_fail):
+        msg = [ln for ln in lines if ln.startswith(f"[b4wave] {op} failed (")]
+        msg2 = [ln for ln in lines2 if ln.startswith(f"[b4wave] {op} failed (")]
+        cond = (len(msg) == 1 and bool(forbid.search(msg[0])) and msg[0].endswith(action)
+                and "RuntimeError: stub backend failure" in msg[0] and len(msg2) == 1
+                and expect_fail >= 1 and aug.stage_counts.get(key, 0) == expect_fail)
+        return report(f"lever_failure_printed_once({lid})", cond,
+                      f"{len(msg)} lines in the first process, {len(msg2)} after a pid change; {key} "
+                      f"{aug.stage_counts.get(key, 0)} (expect {expect_fail}); {msg[:1]}",
+                      [f"{msg[0] if msg else 'no line'}  (x1 for {key} = {aug.stage_counts.get(key, 0)}; "
+                       f"again after a pid change: {len(msg2)})"])
+
+    ok = True
+    for lid, op, key, over, ctx, mod, fn in (("apm_ns", "wrtc_ns", "fail_wrtc_ns", {"aug_apm_p": 1.0}, identity_ns, dsp_apm, "wrtc_ns"),
+                                             ("dtx_gate", "wrtc_dtx", "fail_wrtc_dtx", {"aug_dtx_p": 1.0}, identity_dtx, dsp_dtx, "wrtc_dtx")):
+        a = base_args(no_codec_aug=True, **over)
+        with ctx():
+            with quiet():
+                aug = build_rtc_augmenter_b4(a)
+            saved = getattr(mod, fn)
+            setattr(mod, fn, boom)
+            try:
+                lines = run(aug, n)
+                aug.fail_printed[op] = -1                   # as in a forked worker: another pid
+                lines2 = run(aug, 1)
+            finally:
+                setattr(mod, fn, saved)
+        ok &= verdict(lid, op, key, "passing through", aug, lines, lines2, n + 1)
+    avail, why = _opus_lib_available()
+    if not avail:
+        skip("lever_failure_printed_once(opus_plc)", f"libopus missing: {why}")
+        return ok
+    from b4wave import opus_plc
+    a = base_args(no_codec_aug=False, aug_opus_plc_p=1.0)
+    with quiet():
+        aug = build_rtc_augmenter_b4(a)
+    saved = (opus_plc.opus_loss_roundtrip, opus_plc.ffmpeg_opus)
+    opus_plc.opus_loss_roundtrip = boom
+    opus_plc.ffmpeg_opus = lambda audio, params, sr=16000: (np.asarray(audio, np.float32), params["app"])
+    try:
+        lines = run(aug, n_codec)
+        aug.fail_printed["opus_plc"] = -1
+        lines2 = run(aug, n_codec)
+    finally:
+        opus_plc.opus_loss_roundtrip, opus_plc.ffmpeg_opus = saved
+    n_codec_calls = sum(v for k, v in aug.stage_counts.items() if k.startswith("codec:"))
+    ok &= verdict("opus_plc", "opus_plc", "fail_opus_plc", "ffmpeg fallback with the same profile", aug, lines, lines2,
+                  n_codec_calls)
+    return ok
+
