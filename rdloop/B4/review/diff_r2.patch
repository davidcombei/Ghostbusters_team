+def dtx_dose(arm, heldout):
+    """dose_ratio = the arm's >= 20 %-gated share of its processed clips (both classes pooled) / the heldout
+    vad_gate's (0.321); per-class ratios are printed, the rule uses the pooled one."""
+    h = heldout["all"]["high_share"]
+    ratio, by_class = None, {}
+    if arm is not None and h:
+        a = arm["all"]["high_share"]
+        ratio = (a or 0.0) / h                  # no processed clip: ratio 0 (under-dosed)
+        by_class = {c: (arm[c]["high_share"] or 0.0) / h for c in ("bona", "spoof")}
+    return {"arm": arm, "heldout": heldout, "ratio": ratio, "ratio_by_class": by_class, "min_ratio": DTX_DOSE_MIN,
+            "rule": dose_rule(ratio)}
