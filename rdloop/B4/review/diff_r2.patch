+    c2 = res["tertiles"]["crit2_arm"].get("full_final")
+    mu2 = panel["crit2"]["full_final"]["mu"]
+    wf1 = {k: v["wf1_delta"] for k, v in o["arm"].items()}
+    escape = len(wf1) == 2 and all(v >= DTX_WF1_ESCAPE for v in wf1.values())
+    null = bool(c["did_star"] >= 0 and c2 is not None and c2 <= mu2)
+    f1 = null and not escape
+    clean = {k: v["clean_delta"] for k, v in o["arm"].items() if v["clean_delta"] < -CLEAN_DROP}
+    broken = {f"{k}:{g}": v["arm"][g] for k, v in res["spoof_guards"].items() for g in DTX_GUARDS if v["arm"][g] > v["bound"][g]}
+    f2 = bool(clean) or bool(broken)
