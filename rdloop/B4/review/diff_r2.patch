+    elif f3:
+        decision = "DROP: falsifier (3) fires (shared under-fit)"
+    elif f1 and dose["rule"] == "adequate":
+        decision = "DROP: falsifier (1) fires (gating is not what drives the core)"
+    elif f1:
+        why = ("dose unmeasured (no metrics.jsonl b4 rows)" if dose["ratio"] is None
+               else f"dose ratio {dose['ratio']:.3f} < {DTX_DOSE_MIN:g}")
+        decision = f"{dose['rule']}: owner decides a dose variant (falsifier (1)'s mechanism null at {why}; not a Drop)"
+    else:
+        decision = "no falsifier fires; decide on the lever verdict and the wave's WF1 CI rule"
+    return {"verdict_readout": res["readout"], "vad_did": c["arm"]["did"], "vad_did_star": c["did_star"],
+            "crit2_full_final": c2, "crit2_panel_mu": mu2, "wf1_delta": wf1, "escape": bool(escape),
+            "escape_readouts": "merge_top5 AND final", "mechanism_null": null, "falsifier1": bool(f1),
+            "falsifier2": f2, "clean_below": clean, "guards_broken": broken, "falsifier3": f3,
+            "dose_ratio": dose["ratio"], "dose_rule": dose["rule"], "decision": decision}
